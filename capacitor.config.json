{
  "appId": "com.ledgerly.mobile",
  "appName": "Ledgerly",
  "webDir": "mobile/dist",
  "backgroundColor": "#12151a",
  "android": {
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": true
  },
  "ios": {
    "contentInset": "always",
    "allowsLinkPreview": false,
    "scrollEnabled": false
  },
  "server": {
