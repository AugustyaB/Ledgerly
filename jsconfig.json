{
  "compilerOptions": {
    /* Language and Environment */
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    
    /* Type Checking & JSDoc Analysis */
    "checkJs": true,
    "allowJs": true,
    "strict": false,
    "noEmit": true,
    
    /* Path Resolution */
    "baseUrl": ".",
    "paths": {
      "*": ["src/*", "node_modules/*"]
    }
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "scratch"
  ]
}
