{
  "name": "ledgerly",
  "version": "0.1.0",
  "description": "Ledgerly — A friction-free, 100% offline desktop expense & budget tracker",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "test:ui": "node scratch/test_playwright_ui.js",
    "test:profiles": "node scratch/test_batch2_profiles.js",
    "test:phase5": "node scratch/test_playwright_phase5.js",
    "test:e2e": "node scratch/test_e2e_ledgerly.js",
    "check": "node --check src/main.js && node --check src/preload.js && node --check src/storage.js && node --check src/fileImporter.js && node --check src/receiptStorage.js && node --check src/categoryMatcher.js && node --check src/nlpParser.js && node --check src/foresightEngine.js"
  },
  "build": {
    "appId": "com.ledgerly.desktop",
    "productName": "Ledgerly",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ]
  },
  "keywords": [
    "desktop",
    "expense-tracker",
    "electron",
    "finance",
    "budget",
    "offline-first"
  ],
  "author": "Ledgerly Team",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.2.0",
    "playwright": "^1.62.1"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "chart.js": "^4.5.1",
    "lucide-static": "^1.38.0",
    "xlsx": "^0.18.5"
  }
}
