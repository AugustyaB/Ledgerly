{
  "name": "ledgerly",
  "version": "0.5.2",
  "description": "Ledgerly — A friction-free, 100% offline desktop expense & budget tracker",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build": "electron-builder --win",
    "dist": "electron-builder --win",
    "test:ui": "node scratch/test_playwright_ui.js",
    "test:profiles": "node scratch/test_batch2_profiles.js",
    "test:phase5": "node scratch/test_playwright_phase5.js",
    "test:validation": "node scratch/test_phase5_validation.js",
    "test:resilience": "node scratch/test_phase6_resilience.js",
    "test:phase7": "node scratch/test_phase7_resilience.js",
    "test:normalizer": "node scratch/test_document_normalizer.js",
    "test:e2e": "node scratch/test_e2e_ledgerly.js",
    "check": "node scripts/check-syntax.js",
    "lint": "eslint src/",
    "format": "prettier --write \"src/**/*.{js,html,css}\""
  },
  "build": {
    "appId": "com.ledgerly.desktop",
    "productName": "Ledgerly",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ]
  },
  "keywords": [
    "desktop",
    "expense-tracker",
    "electron",
    "finance",
    "budget",
    "offline-first"
  ],
  "author": "Ledgerly Team",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "electron": "^33.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.10.0",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "chart.js": "^4.5.1",
    "lucide-static": "^1.38.0",
    "pdf-parse": "^2.4.5",
    "xlsx": "^0.18.5"
  }
}
